#!/usr/bin/env bash
set -euo pipefail
export HERMES_HOME="${HERMES_HOME:-$HOME/Code/luna/hermes}"
# Isolate Luna from cloud provider keys that may exist in the parent shell.
unset OPENROUTER_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY GEMINI_API_KEY GOOGLE_API_KEY
unset TAVILY_API_KEY FIREWORKS_API_KEY NOVITA_API_KEY GLM_API_KEY KIMI_API_KEY
unset OLLAMA_API_KEY AI_GATEWAY_API_KEY DEEPSEEK_API_KEY XAI_API_KEY
unset PYTHONPATH PYTHONHOME

# Dagens datum kommer från systemklockan (Europe/Stockholm), aldrig från modellen.
# Hermes läser AGENTS.md-kedjan från git-roten ner till cwd in i systemprompten;
# AGENTS.override.md är gitignorerad och skrivs om vid varje start så raden alltid är färsk.
export HERMES_TIMEZONE="Europe/Stockholm"
LUNA_ROOT="${LUNA_ROOT:-$HOME/Code/luna}"
LUNA_TODAY="$(TZ=Europe/Stockholm date +%Y-%m-%d)"
LUNA_WEEKDAY="$(TZ=Europe/Stockholm LC_ALL=sv_SE.UTF-8 date +%A)"
printf 'Dagens datum är %s (%s).\nDatumet kommer från systemklockan i Europe/Stockholm och är alltid korrekt. Dagens anteckningsfil är daily/%s.md. Räkna aldrig ut datumet på egen hand.\n' \
  "$LUNA_TODAY" "$LUNA_WEEKDAY" "$LUNA_TODAY" > "$LUNA_ROOT/AGENTS.override.md"

cd "${LUNA_VAULT:-$HOME/Code/luna/vault}"
exec "$HOME/.local/bin/hermes" "$@"
